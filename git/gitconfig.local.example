# Copied to ~/.gitconfig.local by install/git.sh on first run.
#
# This file is NEVER tracked. Put anything here that should not live in a
# public repo, or that differs between machines:
#
#   - a work identity
#   - commit signing keys
#   - corporate proxies or url rewrites
#
# It is included LAST by git/gitconfig, so anything set here overrides the
# tracked config.

# Override the identity for this machine:
# [user]
#	email = you@work.example

# Use a different identity inside a directory tree (git >= 2.13):
# [includeIf "gitdir:~/Code/work/"]
#	path = ~/.gitconfig.work

# Sign commits with an ssh key (git >= 2.34):
# [user]
#	signingkey = ~/.ssh/id_ed25519.pub
# [gpg]
#	format = ssh
# [commit]
#	gpgsign = true

# ~/.zprofile — login shells: every new iTerm / Terminal / VS Code tab, and the
# `zsh -l -c …` that GUI apps and IDE tasks run to pick up your environment.
# Those non-interactive shells never read ~/.zshrc, which is why PATH lives
# here. Without this file, /usr/bin/git (Apple's) beats Homebrew's, and
# `code` isn't found.
# Linked from <repo>/zsh/zprofile by _install-scripts/zsh.sh.

typeset -U path   # keep PATH entries unique

# Homebrew first, so its git / node / python win over Apple's builds in
# /usr/bin. (macOS's /etc/zprofile only appends it, after /usr/bin.)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Personal binaries. (N-/) drops the entry if the directory doesn't exist.
path=("$HOME/.local/bin"(N-/) "$HOME/bin"(N-/) $path)

# Editor CLIs that live inside their app bundles: `code` (VS Code).
path+=("/Applications/Visual Studio Code.app/Contents/Resources/app/bin"(N-/))

# Docker Desktop's command-line tools. Homebrew's links in /usr/local/bin come
# first; this adds docker-compose, which only lives here. Docker Desktop's
# first launch prepends its own export of this to ~/.zprofile, which is this
# repo's zprofile — that one can go: git restore zsh/zprofile.
path+=("$HOME/.docker/bin"(N-/))

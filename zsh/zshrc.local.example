# ~/.zshrc.local — this machine only. Sourced last by ~/.zshrc, so it wins.
#
# Never tracked: the repo is public. install/zsh.sh copies this example once
# (mode 600) and never overwrites it afterwards.
#
# Good things to put here:
#
#   export SOME_API_KEY=...                  # secrets
#   export EDITOR='cursor --wait'            # a different editor on this Mac
#   alias work='cd ~/Code/work-project'
#
# Tip: start a command with a space to keep it out of history (HIST_IGNORE_SPACE).
